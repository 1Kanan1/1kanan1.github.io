---
import { ArrowDown } from "lucide-react";
---

<section
  id="home"
  class="relative flex h-screen w-full flex-col items-center justify-center overflow-hidden font-sans text-foreground select-none"
>
  {/* Center Giant Stacked Typography */}
  <div class="pointer-events-none relative z-20">
    <h1 class="text-[20vw] sm:text-[18vw] md:text-[16vw] lg:text-[14vw] font-black leading-[0.75] tracking-tighter flex flex-col items-center">
      <span data-reveal class="text-foreground">KANAN</span>
      <span
        data-reveal
        class="text-transparent"
        style="--reveal-delay: 120ms; -webkit-text-stroke: 2px var(--border)"
      >
        HASANZADE
      </span>
    </h1>
  </div>

  {/* Centered Scroll Prompt */}
  <div class="absolute bottom-8 z-30">
    <a
      href="#skills"
      class="group flex cursor-pointer items-center gap-2 text-[11px] font-medium tracking-[0.2em] text-muted-foreground transition-colors hover:text-foreground"
    >
      <span>SCROLL TO EXPLORE</span>
      <ArrowDown className="size-3.5 transition-transform group-hover:translate-y-1" />
    </a>
  </div>
</section>
