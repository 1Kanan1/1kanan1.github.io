---
import { Building2 } from "lucide-react";
import Container from "@/components/container.astro";
import { cn } from "@/lib/utils";

export interface ExperienceItem {
  id: string;
  period: string;
  role: string;
  company: string;
  logo?: string;
  description: string | string[];
  skills: string[];
}

const defaultExperiences: ExperienceItem[] = [
  {
    id: "andersen",
    period: "Aug 2025 – Aug 2026",
    role: "Frontend Developer",
    company: "Andersen Lab",
    logo: "/andersen-logo.png",
    description: [
      "Developed and maintained <strong>production frontend features</strong>, translating business requirements and UI specifications into functional, type-safe web applications.",
      "Built <strong>reusable UI components</strong> and modular frontend features, emphasizing maintainability, responsive design, and consistency across application interfaces.",
      "Implemented <strong>client-side state management</strong> and asynchronous data-fetching workflows, handling server-state synchronization, caching, and UI updates.",
      "Integrated frontend applications with <strong>REST APIs</strong>, implementing request handling, data validation, loading states, and error-handling flows.",
      "Collaborated with engineering and QA teams in an <strong>Agile/Scrum environment</strong>, contributing to feature delivery, debugging, and ongoing application maintenance.",
    ],
    skills: [
      "React.js",
      "JavaScript",
      "TypeScript",
      "HTML",
      "CSS",
      "Next.js",
      "Redux.js",
      "Tailwind CSS",
      "MUI",
      "React Router",
      "TanStack Query",
      "PostgreSQL",
      "Docker",
      "CI/CD",
      "Code Review",
      "Agile",
      "Scrum",
    ],
  },
  {
    id: "itu-wtdc-25",
    period: "Oct 2025 – Nov 2025",
    role: "Help Desk",
    company: "ITU WTDC-25",
    logo: "/itu-logo.svg",
    description: [
      "Provided technical support to delegates, staff, and event teams, resolving hardware, software, connectivity, and IT service issues throughout the event.",
      "Monitored and prioritized support tickets and incidents, ensuring timely resolution and effective communication with users.",
      "Collaborated with infrastructure and networking teams to troubleshoot technical issues and maintain reliable IT and communication services throughout the event.",
    ],
    skills: ["Help Desk Support", "Technical Support", "Wireless Technologies"],
  },
  {
    id: "company",
    period: "Mar 2023 – May 2025",
    role: "Python Backend Developer",
    company: "Freelance",
    description: [
      "Developed and maintained <strong>backend services and REST APIs</strong>, implementing application logic, service-layer abstractions, and API contracts for web applications.",
      "Implemented <strong>asynchronous request handling</strong> and database access patterns, supporting data-driven application workflows and core business functionality.",
      "Designed and maintained <strong>relational data models</strong> and persistence logic, integrating authentication, authorization, and third-party services into backend workflows.",
      "Containerized backend applications and maintained <strong>CI/CD workflows</strong> for automated testing and deployment, improving consistency across development and delivery environments.",
      "Contributed to a <strong>microservices-oriented architecture</strong>, supporting service integration, separation of concerns, and maintainable backend components.",
    ],
    skills: [
      "Python",
      "FastAPI",
      "SQLAlchemy",
      "SQL",
      "SQLite",
      "PostgreSQL",
      "Docker",
      "Kubernetes",
      "Microservices",
      "CI/CD",
      "Code Review",
      "Design Patterns",
    ],
  },
];

interface Props {
  items?: ExperienceItem[];
  class?: string;
}

const { items = defaultExperiences, class: className } = Astro.props;
---

<section id="experience" class={cn("bg-transparent py-24 md:py-32 text-foreground", className)}>
  <Container>
    <div class="w-full max-w-2xl">
      {/* Section Header */}
      <h2 data-reveal class="text-3xl md:text-4xl font-black tracking-tight text-foreground">
        Work Experience
      </h2>

      {/* Timeline */}
      <div class="mt-12 flex">
        {/* Vertical Connector Line */}
        <div class="w-0.5 shrink-0 mt-1.5 bg-border"></div>

        <ol class="relative">
          {
            items.map((item, index) => {
              const isLast = index === items.length - 1;
              const description = item.description;
              const isString = typeof description === "string";

              return (
                <li
                  data-reveal
                  class={cn("group relative pl-7", !isLast && "pb-12")}
                  style={`--reveal-delay: ${index * 90}ms`}
                >
                  {/* Timeline Node Dot */}
                  <span
                    class="absolute -left-1.75 top-1.5 size-3 rounded-full border-2 border-background bg-muted-foreground ring-2 ring-border transition-all duration-500 group-hover:ring-muted-foreground"
                    aria-hidden="true"
                  />

                  {/* Period */}
                  <time class="text-xs font-mono font-medium tracking-wide text-muted-foreground">
                    {item.period}
                  </time>

                  {/* Role Title */}
                  <h3 class="mt-1 text-lg font-bold tracking-tight text-foreground transition-colors duration-300 group-hover:text-primary">
                    {item.role}
                  </h3>

                  {/* Company */}
                  <div class="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
                    {item.logo ? (
                      <img
                        src={item.logo}
                        alt={`${item.company} logo`}
                        width={18}
                        height={18}
                        class="rounded-sm object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Building2 className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                    )}
                    <span class="font-medium text-foreground/90">{item.company}</span>
                  </div>

                  {/* Description */}
                  <div class="mt-3 text-sm leading-relaxed text-muted-foreground font-light [&_strong]:font-semibold [&_strong]:text-foreground">
                    {isString ? (
                      <p set:html={description} />
                    ) : (
                      <ul class="space-y-1.5 list-disc list-outside pl-4 marker:text-muted-foreground/60">
                        {description.map((desc) => (
                          <li set:html={desc} />
                        ))}
                      </ul>
                    )}
                  </div>

                  {/* Skills Tags */}
                  <ul
                    class="mt-4 flex flex-wrap gap-2"
                    aria-label={`Technologies used at ${item.company}`}
                  >
                    {item.skills.map((skill) => (
                      <li class="rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-mono text-muted-foreground transition-colors duration-300 group-hover:text-foreground group-hover:border-foreground/20">
                        {skill}
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </Container>
</section>
